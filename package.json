{
  "name": "wattsnap-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run setup:offline-ai",
    "dev": "next dev",
    "build": "next build && node scripts/prepare-offline-ai.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test \"src/**/*.test.mjs\" supabase/tests/migration.test.mjs",
    "test:isolation": "node --env-file-if-exists=.env.local --test supabase/tests/isolation.test.mjs",
    "test:sync": "node --env-file-if-exists=.env.local --test supabase/tests/offline-sync.test.mjs",
    "test:sync:browser": "node --env-file-if-exists=.env.local tests/e2e/record-sync.cjs",
    "setup:offline-ai": "node scripts/prepare-offline-ai.mjs --runtime-only",
    "test:offline-ai": "node --test src/features/assistant/hybrid-reply.test.mjs src/features/assistant/tinybert-client.test.mjs src/features/assistant/use-chat.test.mjs tests/offline-shell.test.cjs",
    "setup:email": "node --env-file=.env.local scripts/configure-email.mjs",
    "setup:auth": "node --env-file=.env.local scripts/configure-supabase-auth.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^1.16.0",
    "next": "^15.2.0",
    "nodemailer": "10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "standardwebhooks": "1.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "8.5.29"
  }
}
