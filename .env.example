# Supabase project settings.
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Project URL, for example https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key. Starts with sb_publishable_. Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key. Starts with sb_secret_. Server only. It bypasses row-level security.
SUPABASE_SECRET_KEY=

# Live app origin. Used for trusted authentication email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail sender through Nodemailer. Server only; never use NEXT_PUBLIC_ here.
# Enable Google 2-Step Verification and generate a Gmail App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Supabase Authentication > Hooks > Send Email signing secret.
# Format: v1,whsec_<base64_secret>. Must match the secret configured in Supabase.
SEND_EMAIL_HOOK_SECRET=

# Google Gemini API key. Server only; never expose to browser.
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional. Gemini model for WattSnap AI. Leave empty for gemini-3.5-flash-lite.
GEMINI_MODEL=

# Optional. Gemini model that reads bill photos (same API key). Leave empty for gemini-3.5-flash.
GEMINI_SCAN_MODEL=

# Only for `npm run test:isolation`. The reference of the TEST project: the first part
# of its URL. The test refuses to run unless this matches the URL above.
# Never set this to the production project's reference.
WATTSNAP_TEST_PROJECT_REF=
